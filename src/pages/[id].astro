---
import Base from '../layouts/Base.astro';
import ArticleView from '../components/ArticleView.astro';
import { getCollection, render } from 'astro:content';
import { splitArticle } from '../lib/split';

export async function getStaticPaths() {
	const articles = await getCollection('articles');
	const pages = await getCollection('pages');
	return [
		...articles.map((a) => ({ params: { id: a.id }, props: { kind: 'article', entry: a } })),
		...pages.map((p) => ({ params: { id: p.id }, props: { kind: 'page', entry: p } })),
	];
}

const { kind, entry } = Astro.props;
const { Content } = await render(entry);
const parts = kind === 'article' ? splitArticle(entry.body ?? '') : [];
---
{kind === 'article' ? (
	<ArticleView entry={entry} parts={parts} page={1} />
) : (
	<Base title={entry.data.title}>
		<article class="post">
			<a class="back" href="/">&larr; Back to home</a>
			<h1>{entry.data.title}</h1>
			<div class="content"><Content /></div>
		</article>
	</Base>
)}
