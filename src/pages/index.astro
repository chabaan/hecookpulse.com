---
import Base from '../layouts/Base.astro';
import { getCollection } from 'astro:content';
import { siteConfig } from '../site.config';

const articles = await getCollection('articles');
const sorted = articles.sort((a, b) => {
	const da = a.data.pubDate ? new Date(a.data.pubDate).getTime() : 0;
	const db = b.data.pubDate ? new Date(b.data.pubDate).getTime() : 0;
	return db - da;
});

const pageSize = siteConfig.articlesPerPage;
const pageItems = sorted.slice(0, pageSize);
const lastPage = Math.ceil(sorted.length / pageSize);
const totalArticles = sorted.length;
---
<Base title={`${siteConfig.name} — Home`}>
	<main>
		<section class="welcome">
			<div class="welcome-photo">
				<img src="/images/nora-hale-lake-600.webp" srcset="/images/nora-hale-lake-600.webp 600w, /images/nora-hale-lake.webp 1036w" sizes="(max-width: 760px) 92vw, 480px" alt="Nora Hale on a snowy lake at night" width="600" height="454" fetchpriority="high" decoding="async" />
			</div>
			<div class="welcome-text">
				<div class="welcome-kicker">Welcome to my kitchen</div>
				<h2>Hi, I'm Nora! 👋</h2>
				<p>I'm a home cook from a snowy lakeside village, where the kitchen is always the warmest room in the house. Here I share <strong>simple, tested recipes</strong> for cozy dinners, campfire cooking and sweet treats that work the first time, in any home kitchen.</p>
				<p>Every recipe comes with clear steps, honest timings, and a <strong>free download</strong> so you can keep it forever.</p>
				<div class="welcome-actions">
					<a class="welcome-btn" href="/about-hecookpulse/">Read my story</a>
					<a class="welcome-link" href="#latest">Browse recipes &darr;</a>
				</div>
			</div>
		</section>

		<h2 class="section-title" id="latest">Latest Articles ({totalArticles})</h2>
		<div class="grid">
			{pageItems.map((a, i) => (
				<div class="card">
					<a href={`/${a.id}/`}>
						{i === 0 ? (
							<img class="thumb" src={a.data.image} alt={a.data.title} onerror="this.style.display='none'" />
						) : (
							<img class="thumb" src={a.data.image} alt={a.data.title} loading="lazy" onerror="this.style.display='none'" />
						)}
						<div class="body">
							<div class="cat">{a.data.category}</div>
							<h3>{a.data.title}</h3>
							<p>{(a.data.meta ?? '').slice(0, 100)}...</p>
							<div class="card-meta">
								<span class="avatar">{(a.data.author ?? 'S')[0]}</span>
								<span class="author-name">{a.data.author ?? 'Staff'}</span>
								{a.data.pubDate && (
									<time datetime={new Date(a.data.pubDate).toISOString()}>
										{new Date(a.data.pubDate).toLocaleDateString('en-US', { month: 'long', day: 'numeric', year: 'numeric' })}
									</time>
								)}
							</div>
						</div>
					</a>
				</div>
			))}
		</div>

		{lastPage > 1 && (
			<nav class="pagination">
				<span class="page-link disabled">&larr; Previous</span>
				<span class="page-info">Page 1 of {lastPage}</span>
				<a href="/page/2/" class="page-link">Next &rarr;</a>
			</nav>
		)}
	</main>
</Base>
